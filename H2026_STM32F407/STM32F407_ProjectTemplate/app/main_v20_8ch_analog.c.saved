/* Saved stable V20 eight-channel analog line-follow firmware. */
#include "board.h"
#include "bsp_encoder.h"
#include "bsp_ir_array.h"
#include "bsp_keys.h"
#include "bsp_motor.h"
#include "bsp_stepper.h"
#include "oled.h"
#include "speed_pi.h"

/*
 * Saved H2026 STM32F407 line-follow firmware, stage 11:
 * safe raised-wheel line-follow integration test.
 *
 * D1 is physically on the vehicle's right side.  Positive line error must
 * therefore speed up the left wheel and slow down the right wheel.
 */
#define IR_HYSTERESIS              20U
#define IR_MIN_VALID_SPAN          30U
#define IR_WHITE_CAL_ROUNDS        16U
#define IR_BLACK_SWEEP_ROUNDS      900U

#define TRACK_CONTROL_PERIOD_MS    20U
#define TRACK_BASE_TARGET          26
#define TRACK_MEDIUM_BASE_TARGET   21
#define TRACK_SHARP_BASE_TARGET    16
#define TRACK_LOST_BASE_TARGET     14
#define TRACK_TARGET_MIN           4
#define TRACK_TARGET_MAX           42
#define TRACK_TURN_LIMIT           18
#define TRACK_EDGE_OUTER_TARGET    18
#define TRACK_LOST_STOP_TICKS      40U
#define TRACK_CENTER_MAX_ERROR     8
#define TRACK_DISPLAY_PERIOD_MS    200U

#define SPEED_REFERENCE_TARGET     40
#define FWD_LEFT_FEEDFORWARD       253
#define FWD_RIGHT_FEEDFORWARD      252

static const int8_t ir_position_weights[IR_ARRAY_CHANNEL_COUNT] =
{
    35, 25, 15, 5, -5, -15, -25, -35
};

static void heartbeat_led_init(void)
{
    GPIO_InitTypeDef gpio;

    RCC_AHB1PeriphClockCmd(RCC_AHB1Periph_GPIOB, ENABLE);

    gpio.GPIO_Pin = GPIO_Pin_2;
    gpio.GPIO_Mode = GPIO_Mode_OUT;
    gpio.GPIO_OType = GPIO_OType_PP;
    gpio.GPIO_Speed = GPIO_Speed_50MHz;
    gpio.GPIO_PuPd = GPIO_PuPd_NOPULL;
    GPIO_Init(GPIOB, &gpio);

    GPIO_ResetBits(GPIOB, GPIO_Pin_2);
}

static void oled_show_padded_line(uint8_t y, const uint8_t *text)
{
    uint8_t line[22];
    uint8_t index;

    for(index = 0U; index < 21U; index++)
    {
        line[index] = (uint8_t)' ';
    }

    index = 0U;
    while((index < 21U) && (text[index] != (uint8_t)'\0'))
    {
        line[index] = text[index];
        index++;
    }
    line[21] = (uint8_t)'\0';
    OLED_ShowString(0U, y, line, 8U, 1U);
}

static void show_start_prompt(void)
{
    oled_show_padded_line(0U,  (uint8_t *)"LINE V20 READY");
    oled_show_padded_line(16U, (uint8_t *)"WHITE -> SW1");
    oled_show_padded_line(32U, (uint8_t *)"SW2: BLACK SWEEP");
    oled_show_padded_line(48U, (uint8_t *)"MOTOR DISABLED");
    OLED_Refresh();
}

static void show_white_calibrating(void)
{
    oled_show_padded_line(0U,  (uint8_t *)"WHITE CAL...");
    oled_show_padded_line(16U, (uint8_t *)"KEEP SENSOR STILL");
    oled_show_padded_line(32U, (uint8_t *)"ALL ON WHITE");
    oled_show_padded_line(48U, (uint8_t *)"PLEASE WAIT");
    OLED_Refresh();
}

static void show_white_done(void)
{
    oled_show_padded_line(0U,  (uint8_t *)"WHITE CAL DONE");
    oled_show_padded_line(16U, (uint8_t *)"PRESS SW2, THEN");
    oled_show_padded_line(32U, (uint8_t *)"SWEEP LINE D1-D8");
    oled_show_padded_line(48U, (uint8_t *)"ABOUT 6 SECONDS");
    OLED_Refresh();
}

static void show_black_sweeping(void)
{
    oled_show_padded_line(0U,  (uint8_t *)"BLACK SWEEP NOW");
    oled_show_padded_line(16U, (uint8_t *)"MOVE LINE D1 TO D8");
    oled_show_padded_line(32U, (uint8_t *)"REPEAT UNTIL DONE");
    oled_show_padded_line(48U, (uint8_t *)"RECORDING...");
    OLED_Refresh();
}

static void show_sweep_result(uint8_t weak_mask)
{
    uint8_t weak_line[] = "WEAK:00000000";
    uint8_t channel;

    for(channel = 0U; channel < IR_ARRAY_CHANNEL_COUNT; channel++)
    {
        weak_line[5U + channel] =
            ((weak_mask & (uint8_t)(1U << channel)) != 0U) ?
            (uint8_t)'1' : (uint8_t)'0';
    }

    oled_show_padded_line(0U,  (uint8_t *)"BLACK CAL DONE");
    oled_show_padded_line(16U, weak_line);
    oled_show_padded_line(32U, (uint8_t *)"1=WEAK CHANNEL");
    oled_show_padded_line(48U, (uint8_t *)"NEXT: CENTER LINE");
    OLED_Refresh();
}

static void show_line_ready(const uint8_t states[IR_ARRAY_CHANNEL_COUNT],
                            int8_t error,
                            uint8_t active_count)
{
    uint8_t mask_line[] = "B:00000000";
    uint8_t error_line[] = "E:+000 N:0";
    uint8_t channel;
    uint8_t magnitude;

    for(channel = 0U; channel < IR_ARRAY_CHANNEL_COUNT; channel++)
    {
        mask_line[2U + channel] =
            (states[channel] != 0U) ? (uint8_t)'1' : (uint8_t)'0';
    }

    if(error < 0)
    {
        error_line[2] = (uint8_t)'-';
        magnitude = (uint8_t)(-error);
    }
    else
    {
        error_line[2] = (uint8_t)'+';
        magnitude = (uint8_t)error;
    }
    error_line[3] = (uint8_t)('0' + (magnitude / 100U));
    error_line[4] =
        (uint8_t)('0' + ((magnitude / 10U) % 10U));
    error_line[5] = (uint8_t)('0' + (magnitude % 10U));
    error_line[9] = (uint8_t)('0' + active_count);

    oled_show_padded_line(0U, mask_line);
    oled_show_padded_line(16U, error_line);
    oled_show_padded_line(32U, (uint8_t *)"SW3: START TRACK");
    oled_show_padded_line(48U, (uint8_t *)"SW4: EMERGENCY");
    OLED_Refresh();
}

static void show_tracking_running(int8_t center_bias)
{
    uint8_t bias_line[] = "CENTER BIAS:+0";
    uint8_t magnitude;

    if(center_bias < 0)
    {
        bias_line[12] = (uint8_t)'-';
        magnitude = (uint8_t)(-center_bias);
    }
    else
    {
        magnitude = (uint8_t)center_bias;
    }
    bias_line[13] = (uint8_t)('0' + magnitude);

    oled_show_padded_line(0U,  (uint8_t *)"V20 TRACK START");
    oled_show_padded_line(16U, bias_line);
    oled_show_padded_line(32U, (uint8_t *)"LOW SPEED TEST");
    oled_show_padded_line(48U, (uint8_t *)"SW3/4: STOP");
    OLED_Refresh();
}

static void show_tracking_debug(
    const uint8_t states[IR_ARRAY_CHANNEL_COUNT],
    int8_t error,
    uint8_t active_count,
    int16_t left_target,
    int16_t right_target,
    int8_t edge_direction)
{
    uint8_t mask_line[] = "B:00000000";
    uint8_t error_line[] = "E:+000 N:0";
    uint8_t target_line[] = "T:L00 R00 M:N";
    uint8_t channel;
    uint8_t magnitude;

    for(channel = 0U; channel < IR_ARRAY_CHANNEL_COUNT; channel++)
    {
        mask_line[2U + channel] =
            (states[channel] != 0U) ? (uint8_t)'1' : (uint8_t)'0';
    }

    if(error < 0)
    {
        error_line[2] = (uint8_t)'-';
        magnitude = (uint8_t)(-error);
    }
    else
    {
        error_line[2] = (uint8_t)'+';
        magnitude = (uint8_t)error;
    }
    error_line[3] = (uint8_t)('0' + (magnitude / 100U));
    error_line[4] =
        (uint8_t)('0' + ((magnitude / 10U) % 10U));
    error_line[5] = (uint8_t)('0' + (magnitude % 10U));
    error_line[9] = (uint8_t)('0' + active_count);

    if(left_target < 0)
    {
        left_target = 0;
    }
    if(right_target < 0)
    {
        right_target = 0;
    }
    if(left_target > 99)
    {
        left_target = 99;
    }
    if(right_target > 99)
    {
        right_target = 99;
    }
    target_line[3] =
        (uint8_t)('0' + ((uint16_t)left_target / 10U));
    target_line[4] =
        (uint8_t)('0' + ((uint16_t)left_target % 10U));
    target_line[7] =
        (uint8_t)('0' + ((uint16_t)right_target / 10U));
    target_line[8] =
        (uint8_t)('0' + ((uint16_t)right_target % 10U));
    if(edge_direction > 0)
    {
        target_line[12] = (uint8_t)'R';
    }
    else if(edge_direction < 0)
    {
        target_line[12] = (uint8_t)'L';
    }

    oled_show_padded_line(0U, mask_line);
    oled_show_padded_line(16U, error_line);
    oled_show_padded_line(32U, target_line);
    oled_show_padded_line(48U, (uint8_t *)"SW3/4: STOP");
    OLED_Refresh();
}

static void show_stop_reason(const uint8_t *reason)
{
    oled_show_padded_line(0U, reason);
    oled_show_padded_line(16U, (uint8_t *)"MOTORS DISABLED");
    oled_show_padded_line(32U, (uint8_t *)"CENTER LINE AGAIN");
    oled_show_padded_line(48U, (uint8_t *)"SW3 TO RESTART");
    OLED_Refresh();
}

static void calibrate_white(uint16_t white_values[IR_ARRAY_CHANNEL_COUNT])
{
    uint32_t sums[IR_ARRAY_CHANNEL_COUNT] = {0U};
    uint16_t readings[IR_ARRAY_CHANNEL_COUNT];
    uint8_t round;
    uint8_t channel;

    for(round = 0U; round < IR_WHITE_CAL_ROUNDS; round++)
    {
        ir_array_read_all(readings);
        for(channel = 0U; channel < IR_ARRAY_CHANNEL_COUNT; channel++)
        {
            sums[channel] += readings[channel];
        }
        delay_ms(5U);
    }

    for(channel = 0U; channel < IR_ARRAY_CHANNEL_COUNT; channel++)
    {
        white_values[channel] =
            (uint16_t)(sums[channel] / IR_WHITE_CAL_ROUNDS);
    }
}

static uint8_t calibrate_black_sweep(
    const uint16_t white_values[IR_ARRAY_CHANNEL_COUNT],
    uint16_t thresholds[IR_ARRAY_CHANNEL_COUNT],
    uint16_t black_spans[IR_ARRAY_CHANNEL_COUNT])
{
    uint16_t black_max[IR_ARRAY_CHANNEL_COUNT];
    uint16_t readings[IR_ARRAY_CHANNEL_COUNT];
    uint16_t round;
    uint8_t channel;
    uint8_t weak_mask = 0U;

    for(channel = 0U; channel < IR_ARRAY_CHANNEL_COUNT; channel++)
    {
        black_max[channel] = white_values[channel];
    }

    for(round = 0U; round < IR_BLACK_SWEEP_ROUNDS; round++)
    {
        ir_array_read_all(readings);
        for(channel = 0U; channel < IR_ARRAY_CHANNEL_COUNT; channel++)
        {
            if(readings[channel] > black_max[channel])
            {
                black_max[channel] = readings[channel];
            }
        }
        delay_ms(5U);
    }

    for(channel = 0U; channel < IR_ARRAY_CHANNEL_COUNT; channel++)
    {
        uint16_t span =
            (uint16_t)(black_max[channel] - white_values[channel]);
        uint32_t threshold;

        if(span < IR_MIN_VALID_SPAN)
        {
            weak_mask |= (uint8_t)(1U << channel);
            span = IR_MIN_VALID_SPAN;
        }
        black_spans[channel] = span;

        threshold = (uint32_t)white_values[channel] + (span / 2U);
        if(threshold > (4095U - IR_HYSTERESIS))
        {
            threshold = 4095U - IR_HYSTERESIS;
        }
        thresholds[channel] = (uint16_t)threshold;
    }

    return weak_mask;
}

static int8_t update_line_state(
    const uint16_t readings[IR_ARRAY_CHANNEL_COUNT],
    const uint16_t white_values[IR_ARRAY_CHANNEL_COUNT],
    const uint16_t black_spans[IR_ARRAY_CHANNEL_COUNT],
    const uint16_t thresholds[IR_ARRAY_CHANNEL_COUNT],
    uint8_t raw_states[IR_ARRAY_CHANNEL_COUNT],
    uint8_t selected_states[IR_ARRAY_CHANNEL_COUNT],
    int8_t preferred_position,
    uint8_t *active_count)
{
    uint16_t strengths[IR_ARRAY_CHANNEL_COUNT] = {0U};
    uint8_t best_start = 0U;
    uint8_t best_end = 0U;
    uint8_t best_found = 0U;
    uint16_t best_distance = 0xFFFFU;
    uint32_t best_total_strength = 0U;
    int32_t best_weighted_sum = 0;
    uint8_t channel;

    *active_count = 0U;
    for(channel = 0U; channel < IR_ARRAY_CHANNEL_COUNT; channel++)
    {
        selected_states[channel] = 0U;

        if(raw_states[channel] != 0U)
        {
            if(readings[channel] <
               (uint16_t)(thresholds[channel] - IR_HYSTERESIS))
            {
                raw_states[channel] = 0U;
            }
        }
        else if(readings[channel] >
                (uint16_t)(thresholds[channel] + IR_HYSTERESIS))
        {
            raw_states[channel] = 1U;
        }

        if(raw_states[channel] != 0U)
        {
            uint32_t strength;

            if(readings[channel] > white_values[channel])
            {
                strength =
                    ((uint32_t)(readings[channel] -
                                white_values[channel]) *
                     256U) /
                    black_spans[channel];
                if(strength > 256U)
                {
                    strength = 256U;
                }
            }
            else
            {
                strength = 0U;
            }
            strengths[channel] = (uint16_t)strength;
        }
    }

    /*
     * A tight bend or reflection can produce two separated active groups,
     * for example D1 together with D7-D8.  Averaging both groups invents a
     * false centre.  Split them into contiguous groups and follow the group
     * nearest to the previously followed line position.
     */
    channel = 0U;
    while(channel < IR_ARRAY_CHANNEL_COUNT)
    {
        uint8_t start;
        uint8_t end;
        uint8_t index;
        uint32_t total_strength = 0U;
        int32_t weighted_sum = 0;
        int16_t position;
        int16_t distance;

        while((channel < IR_ARRAY_CHANNEL_COUNT) &&
              ((raw_states[channel] == 0U) ||
               (strengths[channel] == 0U)))
        {
            channel++;
        }
        if(channel >= IR_ARRAY_CHANNEL_COUNT)
        {
            break;
        }

        start = channel;
        while((channel < IR_ARRAY_CHANNEL_COUNT) &&
              (raw_states[channel] != 0U) &&
              (strengths[channel] != 0U))
        {
            weighted_sum +=
                (int32_t)ir_position_weights[channel] *
                (int32_t)strengths[channel];
            total_strength += strengths[channel];
            channel++;
        }
        end = (uint8_t)(channel - 1U);
        position = (int16_t)(weighted_sum /
                             (int32_t)total_strength);
        distance = (int16_t)(position -
                             (int16_t)preferred_position);
        if(distance < 0)
        {
            distance = (int16_t)(-distance);
        }

        if((best_found == 0U) ||
           ((uint16_t)distance < best_distance) ||
           (((uint16_t)distance == best_distance) &&
            (total_strength > best_total_strength)))
        {
            best_found = 1U;
            best_start = start;
            best_end = end;
            best_distance = (uint16_t)distance;
            best_total_strength = total_strength;
            best_weighted_sum = weighted_sum;
        }

        /*
         * Keep ARMCC5 from warning that a loop-local value is only used
         * through the selected range computation above.
         */
        index = end;
        (void)index;
    }

    if(best_found == 0U)
    {
        return 0;
    }

    for(channel = best_start; channel <= best_end; channel++)
    {
        selected_states[channel] = 1U;
        (*active_count)++;
    }

    return (int8_t)(best_weighted_sum /
                    (int32_t)best_total_strength);
}

static int16_t clamp_target(int16_t value)
{
    if(value < TRACK_TARGET_MIN)
    {
        return TRACK_TARGET_MIN;
    }
    if(value > TRACK_TARGET_MAX)
    {
        return TRACK_TARGET_MAX;
    }
    return value;
}

static int16_t clamp_turn(int16_t value)
{
    if(value < -TRACK_TURN_LIMIT)
    {
        return -TRACK_TURN_LIMIT;
    }
    if(value > TRACK_TURN_LIMIT)
    {
        return TRACK_TURN_LIMIT;
    }
    return value;
}

static int16_t scaled_feedforward(int16_t reference_feedforward,
                                  int16_t target)
{
    int32_t result =
        ((int32_t)reference_feedforward * target) /
        SPEED_REFERENCE_TARGET;

    if(result < 100)
    {
        result = 100;
    }
    if(result > 400)
    {
        result = 400;
    }
    return (int16_t)result;
}

static int16_t encoder_delta(uint16_t current, uint16_t previous)
{
    uint16_t wrapped_delta = (uint16_t)(current - previous);
    return (int16_t)wrapped_delta;
}

int main(void)
{
    uint16_t ir_values[IR_ARRAY_CHANNEL_COUNT];
    uint16_t white_values[IR_ARRAY_CHANNEL_COUNT] = {0U};
    uint16_t thresholds[IR_ARRAY_CHANNEL_COUNT] = {0U};
    uint16_t black_spans[IR_ARRAY_CHANNEL_COUNT] = {0U};
    uint8_t line_states[IR_ARRAY_CHANNEL_COUNT] = {0U};
    uint8_t selected_line_states[IR_ARRAY_CHANNEL_COUNT] = {0U};
    uint8_t active_count = 0U;
    uint8_t key_mask;
    uint8_t key_edges;
    uint8_t previous_key_mask = 0U;
    uint8_t white_ready = 0U;
    uint8_t calibrated = 0U;
    uint8_t tracking = 0U;
    uint8_t lost_ticks = 0U;
    int8_t error = 0;
    int8_t previous_error = 0;
    int8_t center_bias = 0;
    uint16_t previous_left_count = 0U;
    uint16_t previous_right_count = 0U;
    uint16_t heartbeat_ms = 0U;
    uint16_t tracking_display_ms = 0U;
    int8_t previous_edge_direction = 0;
    speed_pi_t left_pi;
    speed_pi_t right_pi;

    board_init();
    heartbeat_led_init();
    keys_init();
    motor_init_safe();
    motor_all_stop();
    stepper_init_safe();
    stepper_emergency_stop();
    encoder_init();
    encoder_reset();
    ir_array_init();
    OLED_Init();
    OLED_Clear();
    show_start_prompt();

    while(1)
    {
        key_mask = keys_read_pressed_mask();
        key_edges = (uint8_t)(key_mask & (uint8_t)(~previous_key_mask));
        previous_key_mask = key_mask;

        if(tracking == 0U)
        {
            motor_all_stop();

            if((key_edges & KEY_SW1_MASK) != 0U)
            {
                uint8_t channel;

                show_white_calibrating();
                calibrate_white(white_values);
                for(channel = 0U; channel < IR_ARRAY_CHANNEL_COUNT; channel++)
                {
                    line_states[channel] = 0U;
                    selected_line_states[channel] = 0U;
                }
                white_ready = 1U;
                calibrated = 0U;
                show_white_done();
            }

            if(((key_edges & KEY_SW2_MASK) != 0U) &&
               (white_ready != 0U))
            {
                uint8_t channel;
                uint8_t weak_mask;

                show_black_sweeping();
                weak_mask =
                    calibrate_black_sweep(white_values,
                                          thresholds,
                                          black_spans);
                for(channel = 0U; channel < IR_ARRAY_CHANNEL_COUNT; channel++)
                {
                    line_states[channel] = 0U;
                    selected_line_states[channel] = 0U;
                }
                calibrated = 1U;
                show_sweep_result(weak_mask);
                delay_ms(1200U);
            }

            if(calibrated != 0U)
            {
                ir_array_read_all(ir_values);
                error = update_line_state(ir_values,
                                          white_values,
                                          black_spans,
                                          thresholds,
                                          line_states,
                                          selected_line_states,
                                          0,
                                          &active_count);

                if((key_edges & KEY_SW3_MASK) != 0U)
                {
                    if(active_count == 0U)
                    {
                        show_stop_reason((uint8_t *)"NO LINE: NO START");
                        delay_ms(500U);
                    }
                    else if((error < -TRACK_CENTER_MAX_ERROR) ||
                            (error > TRACK_CENTER_MAX_ERROR))
                    {
                        show_stop_reason((uint8_t *)"CENTER LINE FIRST");
                        delay_ms(500U);
                    }
                    else if((key_mask & KEY_SW4_MASK) == 0U)
                    {
                        /*
                         * The mechanical center rarely lies exactly between
                         * D4 and D5.  Capture the centered reading at start so
                         * a persistent E=+/-1 does not steer the car forever.
                         */
                        center_bias = error;
                        show_tracking_running(center_bias);
                        encoder_reset();
                        previous_left_count = 0U;
                        previous_right_count = 0U;
                        previous_error = 0;
                        previous_edge_direction = 0;
                        lost_ticks = 0U;
                        tracking_display_ms = 0U;
                        speed_pi_reset(&left_pi, TRACK_BASE_TARGET);
                        speed_pi_reset(&right_pi, TRACK_BASE_TARGET);
                        motor_set_both(
                            scaled_feedforward(FWD_LEFT_FEEDFORWARD,
                                               TRACK_BASE_TARGET),
                            scaled_feedforward(FWD_RIGHT_FEEDFORWARD,
                                               TRACK_BASE_TARGET));
                        tracking = 1U;
                    }
                }

                if(tracking == 0U)
                {
                    show_line_ready(selected_line_states,
                                    error,
                                    active_count);
                }
            }
        }
        else
        {
            uint8_t stop_requested =
                ((key_edges & KEY_SW3_MASK) != 0U) ? 1U : 0U;
            uint8_t emergency =
                ((key_mask & KEY_SW4_MASK) != 0U) ? 1U : 0U;

            if((stop_requested != 0U) || (emergency != 0U))
            {
                motor_all_stop();
                tracking = 0U;
                show_stop_reason(
                    (emergency != 0U) ?
                    (uint8_t *)"EMERGENCY STOP" :
                    (uint8_t *)"TRACK STOPPED");
                delay_ms(500U);
            }
            else
            {
                int16_t control_error;
                int16_t turn;
                int16_t base_target;
                int16_t left_target;
                int16_t right_target;
                uint16_t current_left;
                uint16_t current_right;
                int16_t left_measured;
                int16_t right_measured;
                int16_t left_pwm;
                int16_t right_pwm;
                int8_t edge_turn_direction = 0;

                ir_array_read_all(ir_values);
                error = update_line_state(ir_values,
                                          white_values,
                                          black_spans,
                                          thresholds,
                                          line_states,
                                          selected_line_states,
                                          (int8_t)(previous_error +
                                                   center_bias),
                                          &active_count);

                if(active_count == 0U)
                {
                    lost_ticks++;
                    control_error = previous_error;
                    base_target = TRACK_LOST_BASE_TARGET;
                }
                else
                {
                    lost_ticks = 0U;
                    control_error = (int16_t)error -
                                    (int16_t)center_bias;

                    /*
                     * D1 is the rightmost sensor and D8 is the leftmost.
                     * If only the outer two sensors on one side can still see
                     * the line, the vehicle is about to leave the course.
                     */
                    if((active_count <= 2U) &&
                       (selected_line_states[0] != 0U))
                    {
                        edge_turn_direction = 1;
                    }
                    else if((active_count <= 2U) &&
                            (selected_line_states[7] != 0U))
                    {
                        edge_turn_direction = -1;
                    }

                    /*
                     * Keep the full error for proportional steering.  Only
                     * suppress the tiny centre jitter; do not clamp a large
                     * error down to +/-5.
                     */
                    if((control_error >= -2) &&
                       (control_error <= 2))
                    {
                        control_error = 0;
                    }

                    if(edge_turn_direction != 0)
                    {
                        base_target = TRACK_SHARP_BASE_TARGET;
                    }
                    else if((control_error >= 25) ||
                       (control_error <= -25))
                    {
                        base_target = TRACK_SHARP_BASE_TARGET;
                    }
                    else if((control_error >= 12) ||
                            (control_error <= -12))
                    {
                        base_target = TRACK_MEDIUM_BASE_TARGET;
                    }
                    else
                    {
                        base_target = TRACK_BASE_TARGET;
                    }
                }

                if(lost_ticks >= TRACK_LOST_STOP_TICKS)
                {
                    motor_all_stop();
                    tracking = 0U;
                    show_stop_reason((uint8_t *)"LINE LOST: STOP");
                    delay_ms(500U);
                }
                else
                {
                    if(active_count == 0U)
                    {
                        if(previous_error > 3)
                        {
                            turn = TRACK_TURN_LIMIT;
                        }
                        else if(previous_error < -3)
                        {
                            turn = -TRACK_TURN_LIMIT;
                        }
                        else
                        {
                            turn = 0;
                        }
                    }
                    else
                    {
                        /*
                         * Continuous normalized error: proportional and
                         * derivative terms each use a 1/2 scale.
                         */
                        turn = (int16_t)(
                            (control_error +
                             (control_error - previous_error)) /
                            2);
                        turn = clamp_turn(turn);
                    }

                    /*
                     * D1/right gives positive error.  Speeding the left wheel
                     * and slowing the right wheel turns the vehicle right.
                     */
                    if(edge_turn_direction > 0)
                    {
                        left_target = TRACK_EDGE_OUTER_TARGET;
                        right_target = 0;
                    }
                    else if(edge_turn_direction < 0)
                    {
                        left_target = 0;
                        right_target = TRACK_EDGE_OUTER_TARGET;
                    }
                    else
                    {
                        left_target = clamp_target(
                            (int16_t)(base_target + turn));
                        right_target = clamp_target(
                            (int16_t)(base_target - turn));
                    }

                    /*
                     * Discard the old straight/turn integral whenever the
                     * controller enters or leaves an edge-recovery state.
                     */
                    if(edge_turn_direction != previous_edge_direction)
                    {
                        speed_pi_reset(&left_pi, left_target);
                        speed_pi_reset(&right_pi, right_target);
                        previous_edge_direction = edge_turn_direction;
                    }

                    left_pi.target_counts = left_target;
                    right_pi.target_counts = right_target;

                    current_left = (uint16_t)encoder_left_count();
                    current_right = (uint16_t)encoder_right_count();
                    left_measured =
                        encoder_delta(current_left, previous_left_count);
                    right_measured =
                        encoder_delta(current_right, previous_right_count);
                    previous_left_count = current_left;
                    previous_right_count = current_right;

                    if(left_target == 0)
                    {
                        speed_pi_reset(&left_pi, 0);
                        left_pwm = 0;
                    }
                    else
                    {
                        left_pwm = speed_pi_step(
                            &left_pi,
                            left_measured,
                            scaled_feedforward(FWD_LEFT_FEEDFORWARD,
                                               left_target));
                    }
                    if(right_target == 0)
                    {
                        speed_pi_reset(&right_pi, 0);
                        right_pwm = 0;
                    }
                    else
                    {
                        right_pwm = speed_pi_step(
                            &right_pi,
                            right_measured,
                            scaled_feedforward(FWD_RIGHT_FEEDFORWARD,
                                               right_target));
                    }
                    motor_set_both(left_pwm, right_pwm);

                    if(active_count != 0U)
                    {
                        previous_error = (int8_t)control_error;
                    }

                    tracking_display_ms =
                        (uint16_t)(tracking_display_ms +
                                   TRACK_CONTROL_PERIOD_MS);
                    if(tracking_display_ms >= TRACK_DISPLAY_PERIOD_MS)
                    {
                        show_tracking_debug(selected_line_states,
                                            error,
                                            active_count,
                                            left_target,
                                            right_target,
                                            edge_turn_direction);
                        tracking_display_ms = 0U;
                    }
                }
            }
        }

        delay_ms(TRACK_CONTROL_PERIOD_MS);
        heartbeat_ms =
            (uint16_t)(heartbeat_ms + TRACK_CONTROL_PERIOD_MS);
        if(heartbeat_ms >= 500U)
        {
            GPIO_ToggleBits(GPIOB, GPIO_Pin_2);
            heartbeat_ms = 0U;
        }
    }
}
