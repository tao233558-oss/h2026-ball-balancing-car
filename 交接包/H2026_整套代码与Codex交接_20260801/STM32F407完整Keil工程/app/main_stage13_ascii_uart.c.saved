/* Saved stage 13 K230 ASCII UART diagnostic. */
#include "board.h"
#include "bsp_motor.h"
#include "bsp_stepper.h"
#include "bsp_timebase.h"
#include "bsp_vision_uart.h"
#include "oled.h"
#include "vision_ascii_parser.h"

#define VISION_TIMEOUT_MS         200U
#define OLED_UPDATE_PERIOD_MS    100U

static void heartbeat_led_init(void)
{
    GPIO_InitTypeDef gpio;

    RCC_AHB1PeriphClockCmd(RCC_AHB1Periph_GPIOB, ENABLE);
    gpio.GPIO_Pin = GPIO_Pin_2;
    gpio.GPIO_Mode = GPIO_Mode_OUT;
    gpio.GPIO_OType = GPIO_OType_PP;
    gpio.GPIO_Speed = GPIO_Speed_50MHz;
    gpio.GPIO_PuPd = GPIO_PuPd_NOPULL;
    GPIO_Init(GPIOB, &gpio);
    GPIO_ResetBits(GPIOB, GPIO_Pin_2);
}

static void oled_show_padded_line(uint8_t y, const uint8_t *text)
{
    uint8_t line[22];
    uint8_t index;

    for(index = 0U; index < 21U; index++)
    {
        line[index] = (uint8_t)' ';
    }
    index = 0U;
    while((index < 21U) && (text[index] != (uint8_t)'\0'))
    {
        line[index] = text[index];
        index++;
    }
    line[21] = (uint8_t)'\0';
    OLED_ShowString(0U, y, line, 8U, 1U);
}

static void format_unsigned(uint8_t *line,
                            uint8_t start,
                            uint32_t value,
                            uint8_t digits)
{
    uint8_t index;

    for(index = 0U; index < digits; index++)
    {
        uint8_t output =
            (uint8_t)(start + digits - 1U - index);
        line[output] = (uint8_t)('0' + (value % 10U));
        value /= 10U;
    }
}

static void show_uart_state(
    const vision_ascii_parser_t *parser,
    uint8_t fresh,
    uint32_t age_ms,
    uint32_t overflow_count)
{
    uint8_t coordinate_line[] = "X:000 Y:000 VALID:0";
    uint8_t count_line[] = "OK:00000 ER:00000";
    uint8_t status_line[] = "AGE:000ms OV:000";

    format_unsigned(coordinate_line, 2U, parser->x, 3U);
    format_unsigned(coordinate_line, 8U, parser->y, 3U);
    coordinate_line[18] =
        (fresh != 0U) ? (uint8_t)'1' : (uint8_t)'0';

    format_unsigned(count_line,
                    3U,
                    parser->frame_count % 100000U,
                    5U);
    format_unsigned(count_line,
                    12U,
                    parser->error_count % 100000U,
                    5U);

    if(age_ms > 999U)
    {
        age_ms = 999U;
    }
    format_unsigned(status_line, 4U, age_ms, 3U);
    format_unsigned(status_line,
                    13U,
                    overflow_count % 1000U,
                    3U);

    oled_show_padded_line(0U, (uint8_t *)"K230 ASCII 9600");
    oled_show_padded_line(16U, coordinate_line);
    oled_show_padded_line(32U, count_line);
    oled_show_padded_line(48U, status_line);
    OLED_Refresh();
}

int main(void)
{
    vision_ascii_parser_t parser;
    uint32_t last_packet_ms = 0U;
    uint32_t next_oled_ms = 0U;
    uint32_t last_heartbeat_ms = 0U;
    uint8_t have_packet = 0U;

    board_init();
    heartbeat_led_init();
    motor_init_safe();
    motor_all_stop();
    stepper_init_safe();
    stepper_emergency_stop();
    timebase_init_1ms();
    vision_ascii_parser_init(&parser);
    vision_uart_init(9600U);

    OLED_Init();
    OLED_Clear();
    show_uart_state(&parser, 0U, 999U, 0U);

    while(1)
    {
        uint8_t byte;
        uint32_t now_ms = timebase_millis();

        while(vision_uart_read_byte(&byte) != 0U)
        {
            vision_ascii_result_t result =
                vision_ascii_parser_push(&parser, byte);
            if(result == VISION_ASCII_FRAME_OK)
            {
                have_packet = 1U;
                last_packet_ms = now_ms;
            }
        }

        if((int32_t)(now_ms - next_oled_ms) >= 0)
        {
            uint32_t age_ms =
                (have_packet != 0U) ?
                (now_ms - last_packet_ms) :
                999U;
            uint8_t fresh =
                ((have_packet != 0U) &&
                 (age_ms <= VISION_TIMEOUT_MS)) ? 1U : 0U;

            show_uart_state(&parser,
                            fresh,
                            age_ms,
                            vision_uart_get_overflow_count());
            next_oled_ms = now_ms + OLED_UPDATE_PERIOD_MS;
        }

        if((now_ms - last_heartbeat_ms) >= 500U)
        {
            GPIO_ToggleBits(GPIOB, GPIO_Pin_2);
            last_heartbeat_ms = now_ms;
        }
    }
}
