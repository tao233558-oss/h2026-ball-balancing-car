      "para_index": 12,
      "text": "\u8f66\u8f7d\u5e73\u8861\u6eda\u7403\u8fd0\u52a8\u63a7\u5236\u7cfb\u7edf",
      "style": "Normal"
    },
    {
      "para_index": 13,
      "text": "\u6458  \u8981",
      "style": "Normal"
    },
    {
      "para_index": 15,
      "text": "\u5173\u952e\u8bcd\uff1a\u5dee\u901f\u5faa\u8ff9\uff1b\u8f66\u8f7d\u6eda\u7403\uff1b\u89c6\u89c9\u6807\u5b9a\uff1b\u6b65\u8fdb\u7535\u673a\uff1b\u72b6\u6001\u673a",
      "style": "Normal"
    },
    {
      "para_index": 16,
      "text": "\u7cfb\u7edf\u7279\u5f81\u6458\u8981",
      "style": "Normal"
    },
    {
      "para_index": 19,
      "text": "\u76ee  \u5f55",
      "style": "Normal"
    },
    {
      "para_index": 20,
      "text": "\u6458\u8981\t3",
      "style": "Normal"
    },
    {
      "para_index": 21,
      "text": "1  \u7cfb\u7edf\u65b9\u6848\u4e0e\u603b\u4f53\u8bbe\u8ba1\t5",
      "style": "Normal"
    },
    {
      "para_index": 24,
      "text": "2  \u7ea2\u5916\u5faa\u8ff9\u4e0e\u5dee\u901f\u8fd0\u52a8\u63a7\u5236\t6",
      "style": "Normal"
    },
    {
      "para_index": 25,
      "text": "3  \u5355\u81ea\u7531\u5ea6\u6eda\u7403\u673a\u6784\u4e0e\u52a8\u529b\u5b66\t7",
      "style": "Normal"
    },
    {
      "para_index": 26,
      "text": "4  \u89c6\u89c9\u6d4b\u91cf\u3001\u6807\u5b9a\u4e0e\u4e32\u53e3\u94fe\u8def\t8",
      "style": "Normal"
    },
    {
      "para_index": 27,
      "text": "5  \u6eda\u7403\u95ed\u73af\u63a7\u5236\u4e0e\u98983\u72b6\u6001\u673a\t9",
      "style": "Normal"
    },
    {
      "para_index": 28,
      "text": "6  \u786c\u4ef6\u63a5\u53e3\u3001\u8f6f\u4ef6\u7ed3\u6784\u4e0e\u5b89\u5168\u8bbe\u8ba1\t10",
      "style": "Normal"
    },
    {
      "para_index": 29,
      "text": "7  \u7cfb\u7edf\u6d4b\u8bd5\u4e0e\u7ed3\u679c\u5206\u6790\t11",
      "style": "Normal"
    },
    {
      "para_index": 30,
      "text": "8  \u8bef\u5dee\u6765\u6e90\u3001\u6539\u8fdb\u8def\u5f84\u4e0e\u7ed3\u8bba\t12",
      "style": "Normal"
