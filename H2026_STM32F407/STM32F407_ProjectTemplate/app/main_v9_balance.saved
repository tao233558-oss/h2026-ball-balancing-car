/* H2026 static ball-balance controller, V2 safe test build. */
#include "ball_balance.h"
#include "board.h"
#include "bsp_keys.h"
#include "bsp_motor.h"
#include "bsp_stepper.h"
#include "bsp_timebase.h"
#include "bsp_vision_uart.h"
#include "oled.h"
#include "vision_ascii_parser.h"

#define VISION_TIMEOUT_MS             200U
#define CONTROL_PERIOD_MS              10U
#define OLED_UPDATE_PERIOD_MS         200U
#define KEY_EDGE_LOCKOUT_MS            80U

#define MANUAL_JOG_SPEED_STEPS_S      180
#define LEVEL_RETURN_SPEED_STEPS_S    160
#define ACTIVE_SPEED_LIMIT_STEPS_S    180
#define SPEED_ACCEL_PER_CONTROL        10
#define POSITION_CONTROL_GAIN           4
#define POSITION_DEADBAND_STEPS          2
#define TARGET_SLEW_STEPS_PER_CONTROL   50
#define ACTUATOR_SOFT_LIMIT_STEPS      450

#define SETPOINT_LEFT_MM              (-50)
#define SETPOINT_CENTER_MM               0
#define SETPOINT_RIGHT_MM               50

typedef enum
{
    APP_LEVEL_SETUP = 0,
    APP_READY,
    APP_ACTIVE,
    APP_VISION_LOST,
    APP_SOFT_LIMIT,
    APP_ESTOP
} app_state_t;

static void heartbeat_led_init(void)
{
    GPIO_InitTypeDef gpio;

    RCC_AHB1PeriphClockCmd(RCC_AHB1Periph_GPIOB, ENABLE);
    gpio.GPIO_Pin = GPIO_Pin_2;
    gpio.GPIO_Mode = GPIO_Mode_OUT;
    gpio.GPIO_OType = GPIO_OType_PP;
    gpio.GPIO_Speed = GPIO_Speed_50MHz;
    gpio.GPIO_PuPd = GPIO_PuPd_NOPULL;
    GPIO_Init(GPIOB, &gpio);
    GPIO_ResetBits(GPIOB, GPIO_Pin_2);
}

static void oled_show_padded_line(uint8_t y, const uint8_t *text)
{
    uint8_t line[22];
    uint8_t index;

    for(index = 0U; index < 21U; index++)
    {
        line[index] = (uint8_t)' ';
    }
    index = 0U;
    while((index < 21U) && (text[index] != (uint8_t)'\0'))
    {
        line[index] = text[index];
        index++;
    }
    line[21] = (uint8_t)'\0';
    OLED_ShowString(0U, y, line, 8U, 1U);
}

static void format_unsigned(uint8_t *line,
                            uint8_t start,
                            uint32_t value,
                            uint8_t digits)
{
    uint8_t index;

    for(index = 0U; index < digits; index++)
    {
        uint8_t output =
            (uint8_t)(start + digits - 1U - index);
        line[output] = (uint8_t)('0' + (value % 10U));
        value /= 10U;
    }
}

static void format_signed(uint8_t *line,
                          uint8_t sign_index,
                          int32_t value,
                          uint8_t digits)
{
    uint32_t magnitude;

    if(value < 0)
    {
        line[sign_index] = (uint8_t)'-';
        magnitude = (uint32_t)(-value);
    }
    else
    {
        line[sign_index] = (uint8_t)'+';
        magnitude = (uint32_t)value;
    }
    format_unsigned(line,
                    (uint8_t)(sign_index + 1U),
                    magnitude,
                    digits);
}

static int16_t clamp_speed(int32_t speed, int16_t limit)
{
    if(speed > limit)
    {
        return limit;
    }
    if(speed < -limit)
    {
        return (int16_t)(-limit);
    }
    return (int16_t)speed;
}

static int16_t ramp_speed(int16_t current, int16_t target)
{
    if(current < target)
    {
        int32_t next =
            (int32_t)current + SPEED_ACCEL_PER_CONTROL;
        return (next > target) ? target : (int16_t)next;
    }
    if(current > target)
    {
        int32_t next =
            (int32_t)current - SPEED_ACCEL_PER_CONTROL;
        return (next < target) ? target : (int16_t)next;
    }
    return current;
}

static int16_t ramp_position(int16_t current, int16_t target)
{
    if(current < target)
    {
        int32_t next =
            (int32_t)current + TARGET_SLEW_STEPS_PER_CONTROL;
        return (next > target) ? target : (int16_t)next;
    }
    if(current > target)
    {
        int32_t next =
            (int32_t)current - TARGET_SLEW_STEPS_PER_CONTROL;
        return (next < target) ? target : (int16_t)next;
    }
    return current;
}

static int16_t actuator_position_speed(int16_t target_position,
                                       int16_t speed_limit)
{
    int32_t error =
        (int32_t)target_position - stepper_get_position();

    if((error >= -POSITION_DEADBAND_STEPS) &&
       (error <= POSITION_DEADBAND_STEPS))
    {
        return 0;
    }
    return clamp_speed(error * POSITION_CONTROL_GAIN,
                       speed_limit);
}

static const uint8_t *state_title(app_state_t state)
{
    switch(state)
    {
        case APP_LEVEL_SETUP:
            return (const uint8_t *)"V9 LEVEL SW1UP SW2DN";
        case APP_READY:
            return (const uint8_t *)"V9 READY SW3=AUTO";
        case APP_ACTIVE:
            return (const uint8_t *)"V9 ACTIVE 1- 2C 3+";
        case APP_VISION_LOST:
            return (const uint8_t *)"V9 VISION LOST RETRY";
        case APP_SOFT_LIMIT:
            return (const uint8_t *)"SOFT LIMIT RESET";
        default:
            return (const uint8_t *)"E-STOP RESET BOARD";
    }
}

static void show_state(app_state_t state,
                       const vision_ascii_parser_t *parser,
                       const ball_balance_t *balance,
                       uint8_t vision_fresh,
                       int16_t setpoint_mm,
                       int16_t target_steps)
{
    uint8_t coordinate_line[] = "X:000 M:+000 F:0";
    uint8_t velocity_line[] = "V:+000 SP:+000";
    uint8_t motion_line[] = "T:+0000 P:+0000";

    format_unsigned(coordinate_line, 2U, parser->x, 3U);
    format_signed(coordinate_line, 8U, balance->x_mm, 3U);
    coordinate_line[15] =
        (vision_fresh != 0U) ? (uint8_t)'1' : (uint8_t)'0';

    format_signed(velocity_line,
                  2U,
                  balance->velocity_mm_s,
                  3U);
    format_signed(velocity_line, 10U, setpoint_mm, 3U);

    format_signed(motion_line, 2U, target_steps, 4U);
    format_signed(motion_line,
                  10U,
                  stepper_get_position(),
                  4U);

    oled_show_padded_line(0U, state_title(state));
    oled_show_padded_line(16U, coordinate_line);
    oled_show_padded_line(32U, velocity_line);
    oled_show_padded_line(48U, motion_line);
    OLED_Refresh();
}

int main(void)
{
    vision_ascii_parser_t parser;
    ball_balance_t balance;
    app_state_t state = APP_LEVEL_SETUP;
    uint32_t last_packet_ms = 0U;
    uint32_t next_control_ms = 0U;
    uint32_t next_oled_ms = 0U;
    uint32_t last_heartbeat_ms = 0U;
    uint32_t last_key_edge_ms = 0U;
    uint8_t have_packet = 0U;
    uint8_t previous_key_mask = 0U;
    uint8_t stepper_enabled = 0U;
    int16_t setpoint_mm = SETPOINT_CENTER_MM;
    int16_t requested_steps = 0;
    int16_t target_steps = 0;
    int16_t commanded_speed = 0;

    board_init();
    heartbeat_led_init();
    keys_init();
    motor_init_safe();
    motor_all_stop();
    stepper_init_safe();
    stepper_emergency_stop();
    timebase_init_1ms();
    vision_ascii_parser_init(&parser);
    ball_balance_init(&balance);
    vision_uart_init(9600U);

    OLED_Init();
    OLED_Clear();
    show_state(state,
               &parser,
               &balance,
               0U,
               setpoint_mm,
               target_steps);

    while(1)
    {
        uint8_t byte;
        uint8_t key_mask;
        uint8_t key_edges;
        uint8_t vision_fresh;
        uint8_t new_measurement = 0U;
        uint32_t now_ms = timebase_millis();

        while(vision_uart_read_byte(&byte) != 0U)
        {
            vision_ascii_result_t result =
                vision_ascii_parser_push(&parser, byte);
            if(result == VISION_ASCII_FRAME_OK)
            {
                have_packet = 1U;
                last_packet_ms = now_ms;
                new_measurement = 1U;
            }
        }

        /*
         * OLED transfers can leave several complete UART frames buffered.
         * Submit only the newest coordinate once per main-loop pass so that
         * multiple frames drained in the same millisecond cannot force the
         * calculated velocity back to zero.
         */
        if(new_measurement != 0U)
        {
            ball_balance_update_measurement(
                &balance,
                parser.x,
                parser.frame_count,
                now_ms);
        }

        vision_fresh =
            ((have_packet != 0U) &&
             ((now_ms - last_packet_ms) <=
              VISION_TIMEOUT_MS)) ? 1U : 0U;

        key_mask = keys_read_pressed_mask();
        key_edges =
            (uint8_t)(key_mask &
                      (uint8_t)(~previous_key_mask));
        previous_key_mask = key_mask;
        if(key_edges != 0U)
        {
            if((now_ms - last_key_edge_ms) <
               KEY_EDGE_LOCKOUT_MS)
            {
                key_edges = 0U;
            }
            else
            {
                last_key_edge_ms = now_ms;
            }
        }

        if((key_mask & KEY_SW4_MASK) != 0U)
        {
            stepper_emergency_stop();
            stepper_enabled = 0U;
            commanded_speed = 0;
            state = APP_ESTOP;
        }
        else if(state == APP_LEVEL_SETUP)
        {
            if(((key_mask & KEY_SW1_MASK) != 0U) &&
               ((key_mask & KEY_SW2_MASK) == 0U))
            {
                if(stepper_enabled == 0U)
                {
                    stepper_enable(1U);
                    delay_ms(3U);
                    stepper_enabled = 1U;
                }
                commanded_speed = MANUAL_JOG_SPEED_STEPS_S;
                stepper_set_speed(commanded_speed);
            }
            else if(((key_mask & KEY_SW2_MASK) != 0U) &&
                    ((key_mask & KEY_SW1_MASK) == 0U))
            {
                if(stepper_enabled == 0U)
                {
                    stepper_enable(1U);
                    delay_ms(3U);
                    stepper_enabled = 1U;
                }
                commanded_speed = -MANUAL_JOG_SPEED_STEPS_S;
                stepper_set_speed(commanded_speed);
            }
            else
            {
                commanded_speed = 0;
                stepper_set_speed(0);
            }

            if((key_edges & KEY_SW3_MASK) != 0U)
            {
                if(stepper_enabled == 0U)
                {
                    stepper_enable(1U);
                    delay_ms(3U);
                    stepper_enabled = 1U;
                }
                stepper_set_speed(0);
                commanded_speed = 0;
                stepper_set_position(0);
                requested_steps = 0;
                target_steps = 0;
                setpoint_mm = SETPOINT_CENTER_MM;
                state = APP_READY;
            }
        }
        else if((state == APP_ESTOP) ||
                (state == APP_SOFT_LIMIT))
        {
            /* Faults stay latched until the board is reset. */
        }
        else if(state == APP_READY)
        {
            if(((key_edges & KEY_SW3_MASK) != 0U) &&
               (vision_fresh != 0U))
            {
                ball_balance_init(&balance);
                ball_balance_update_measurement(
                    &balance,
                    parser.x,
                    parser.frame_count,
                    now_ms);
                setpoint_mm = SETPOINT_CENTER_MM;
                state = APP_ACTIVE;
            }
        }
        else if(state == APP_ACTIVE)
        {
            if(vision_fresh == 0U)
            {
                commanded_speed = 0;
                stepper_set_speed(0);
                requested_steps =
                    (int16_t)stepper_get_position();
                target_steps = requested_steps;
                state = APP_VISION_LOST;
            }
            else if((key_edges & KEY_SW1_MASK) != 0U)
            {
                setpoint_mm = SETPOINT_LEFT_MM;
            }
            else if((key_edges & KEY_SW2_MASK) != 0U)
            {
                setpoint_mm = SETPOINT_CENTER_MM;
            }
            else if((key_edges & KEY_SW3_MASK) != 0U)
            {
                setpoint_mm = SETPOINT_RIGHT_MM;
            }
        }
        else
        {
            /* APP_VISION_LOST: keep holding the present mechanism height. */
            commanded_speed = 0;
            stepper_set_speed(0);
            if(((key_edges & KEY_SW3_MASK) != 0U) &&
               (vision_fresh != 0U))
            {
                ball_balance_init(&balance);
                ball_balance_update_measurement(
                    &balance,
                    parser.x,
                    parser.frame_count,
                    now_ms);
                requested_steps =
                    (int16_t)stepper_get_position();
                target_steps = requested_steps;
                setpoint_mm = SETPOINT_CENTER_MM;
                state = APP_ACTIVE;
            }
        }

        if((int32_t)(now_ms - next_control_ms) >= 0)
        {
            next_control_ms = now_ms + CONTROL_PERIOD_MS;

            if(state == APP_ACTIVE)
            {
                requested_steps =
                    ball_balance_target_steps(&balance,
                                              setpoint_mm);
                target_steps = ramp_position(target_steps,
                                             requested_steps);
            }
            else if(state == APP_READY)
            {
                requested_steps = 0;
                target_steps = ramp_position(target_steps, 0);
            }

            if((state == APP_READY) ||
               (state == APP_ACTIVE))
            {
                int16_t desired_speed;
                int16_t speed_limit =
                    (state == APP_ACTIVE) ?
                    ACTIVE_SPEED_LIMIT_STEPS_S :
                    LEVEL_RETURN_SPEED_STEPS_S;
                int32_t position = stepper_get_position();

                if((position >= ACTUATOR_SOFT_LIMIT_STEPS) ||
                   (position <= -ACTUATOR_SOFT_LIMIT_STEPS))
                {
                    stepper_emergency_stop();
                    stepper_enabled = 0U;
                    commanded_speed = 0;
                    state = APP_SOFT_LIMIT;
                }
                else
                {
                    desired_speed =
                        actuator_position_speed(target_steps,
                                                speed_limit);
                    /*
                     * Never coast in the old direction after a moving target
                     * has crossed the measured actuator position.  P is a
                     * commanded-step counter, so this immediate pulse stop is
                     * the only reliable way to prevent target overshoot.
                     */
                    if((desired_speed == 0) ||
                       ((commanded_speed > 0) &&
                        (desired_speed < 0)) ||
                       ((commanded_speed < 0) &&
                        (desired_speed > 0)))
                    {
                        commanded_speed = 0;
                    }
                    else
                    {
                        commanded_speed =
                            ramp_speed(commanded_speed,
                                       desired_speed);
                    }
                    stepper_set_speed(commanded_speed);
                }
            }
        }

        if((int32_t)(now_ms - next_oled_ms) >= 0)
        {
            show_state(state,
                       &parser,
                       &balance,
                       vision_fresh,
                       setpoint_mm,
                       target_steps);
            next_oled_ms = now_ms + OLED_UPDATE_PERIOD_MS;
        }

        if((now_ms - last_heartbeat_ms) >= 500U)
        {
            GPIO_ToggleBits(GPIOB, GPIO_Pin_2);
            last_heartbeat_ms = now_ms;
        }
    }
}
